# Encrypts saved provider keys. Make your own (never reuse an example):
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Changing it later: deploy/harden.sh moves the saved keys to the new one.
CBC_MASTER_KEY=
DATABASE_URL=postgresql+psycopg2://cbc_user:cbc_password@host.docker.internal:5432/cbc_db
REDIS_URL=redis://localhost:6379/0

# MinIO S3 Object Storage
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_BUCKET=cbc-assets
MINIO_PUBLIC_BASE_URL=http://localhost:9000

# LLM Providers
OPENAI_API_KEY=sk-...
# OpenAI models by tier. DEFAULT writes (notes, material, questions, rewrites, review);
# LIGHT reads (research, classification, extraction). Effort: minimal | low | medium | high —
# reasoning tokens are billed as OUTPUT, so this is the cost dial.
OPENAI_DEFAULT_MODEL=gpt-6-sol
OPENAI_REASONING_EFFORT=medium
OPENAI_LIGHT_MODEL=gpt-6-luna
OPENAI_LIGHT_REASONING_EFFORT=low
# A long random string enables a read-only log link: /api/v1/admin/logs/share?token=<this>. Leave empty to disable.
LOG_SHARE_TOKEN=
# Printed at the head and foot of every paper composed from the bank — your brand.
PAPER_SERIES_NAME=
# Stored log lines are pruned hourly by the worker: older than N days, and beyond N rows
LOG_RETENTION_DAYS=7
LOG_KEEP_ROWS=20000
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=AIzaSy...
OLLAMA_BASE_URL=http://localhost:11434

# Langfuse Configuration (Self-hosted or Cloud)
LANGFUSE_HOST=http://localhost:3001
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_ENV=prod
LANGFUSE_CACHE_TTL=300

# SMTP mail server: password-reset links, email-confirmation links, milestone alerts.
# The same mailbox CVPAP sends from works: SMTP_HOST = its MAIL_SERVER,
# SMTP_USER = ADMIN_EMAIL, SMTP_PASSWORD = ADMIN_EMAIL_PASSWORD. Port 587 with
# SMTP_SECURE=false uses STARTTLS; 465 with SMTP_SECURE=true uses SSL.
# Links in those emails point at the Public address (Settings, or PUBLIC_BASE_URL).
SMTP_HOST=mail.yourserver.com
SMTP_PORT=587
SMTP_USER=notifications@yourserver.com
SMTP_PASSWORD=your_smtp_password
SMTP_FROM=notifications@yourserver.com
SMTP_SECURE=false
EMAIL_RECIPIENTS=admin@cbc-platform.ke,lead_curriculum@cbc-platform.ke

# Frontend & Proxy
VITE_API_BASE_URL=/api
API_PROXY_TARGET=http://api:8000

# JWT & Authentication
# 32+ random characters:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# (Missing or weak, the API makes a strong one and keeps it in the database.)
JWT_SECRET=
JWT_EXP_MINUTES=480
REFRESH_TOKEN_EXP_DAYS=7
# Optional: sets that built-in account's password at every start (12+ characters,
# not a default). Leave empty and use: docker compose exec api python -m app.admin_tools reset-password --username admin
ADMIN_PASSWORD=
OPERATOR_PASSWORD=
REVIEWER_PASSWORD=
DEVELOPER_PASSWORD=
# Optional fixed developer key (32+ random characters). Prefer keys made in the console.
DEVELOPER_API_KEY=

# Google Drive: finished videos are moved there and linked from there.
# Make the refresh token once with:  python3 backend/scripts/drive_auth.py
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
# Optional: a folder you made (its id from the URL); else "CBC videos" is created.
GOOGLE_DRIVE_FOLDER_ID=
# Days the server keeps its own copy after a checked move (0 = remove at once).
DRIVE_KEEP_LOCAL_DAYS=2

# --- Wallet top-ups: M-Pesa STK push (Safaricom Daraja) ---
# sandbox while testing (shortcode 174379 and Daraja's test passkey), production when live.
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
# Paybill: the paybill number. Till: the store (head office) number, and MPESA_TILL_NUMBER below.
MPESA_SHORTCODE=
MPESA_PASSKEY=
# paybill | till
MPESA_TYPE=paybill
MPESA_TILL_NUMBER=
# A long random string; Safaricom calls /api/v1/billing/mpesa/callback/<this>.
# Make one with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
MPESA_CALLBACK_TOKEN=
